set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSROOT "$ENV{LORELEI_DEVKIT}/x86_64/sysroot")
find_program(AE_X64_GCC NAMES x86_64-linux-gnu-gcc REQUIRED)
find_program(AE_X64_GXX NAMES x86_64-linux-gnu-g++ REQUIRED)
set(CMAKE_C_COMPILER "${AE_X64_GCC}")
set(CMAKE_CXX_COMPILER "${AE_X64_GXX}")
set(CMAKE_FIND_ROOT_PATH "$ENV{LORELEI_DEVKIT}/x86_64/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
