{
  "name": "redeclipse",
  "version": "2.0.0",
  "port-version": 2,
  "description": "Pinned Red Eclipse game package for native and guest game evaluation",
  "homepage": "https://www.redeclipse.net/",
  "license": "Zlib",
  "supports": "linux & !x86",
  "dependencies": [
    {
      "name": "libx11",
      "platform": "!x64"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "features": ["x11"],
      "platform": "!x64"
    },
    {
      "name": "sdl2-image",
      "default-features": false,
      "platform": "!x64"
    },
    {
      "name": "sdl2-mixer",
      "default-features": false,
      "platform": "!x64"
    },
    {
      "name": "zlib",
      "platform": "!x64"
    },
    {
      "name": "pkgconf",
      "host": true,
      "platform": "!x64"
    }
  ]
}
