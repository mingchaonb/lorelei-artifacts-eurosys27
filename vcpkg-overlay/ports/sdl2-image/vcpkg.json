{
  "name": "sdl2-image",
  "version": "2.8.12",
  "port-version": 1,
  "description": "SDL2_image shared-library build used by the Lorelei AE evaluation",
  "homepage": "https://github.com/libsdl-org/SDL_image",
  "license": "Zlib",
  "supports": "linux",
  "dependencies": [
    {
      "name": "sdl2",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "hlr": {
      "description": "Rewrite the SDL2_image shared library with Lorelei HLR"
    }
  }
}
