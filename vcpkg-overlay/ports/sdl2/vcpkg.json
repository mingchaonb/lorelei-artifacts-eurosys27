{
  "name": "sdl2",
  "version": "2.28.5",
  "description": "SDL2 build used by the Lorelei AE library-validation recipe",
  "homepage": "https://github.com/libsdl-org/SDL",
  "license": "Zlib",
  "supports": "linux",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "hlr": {
      "description": "Rewrite the host source closure with Lorelei HLR",
      "dependencies": [
        {
          "name": "libx11",
          "features": ["hlr"]
        },
        {
          "name": "libxext",
          "features": ["hlr"]
        },
        {
          "name": "libxrender",
          "features": ["hlr"]
        },
        {
          "name": "libxrandr",
          "features": ["hlr"]
        },
        {
          "name": "libxfixes",
          "features": ["hlr"]
        },
        {
          "name": "libxi",
          "features": ["hlr"]
        },
        {
          "name": "libxcursor",
          "features": ["hlr"]
        },
        {
          "name": "libxscrnsaver",
          "features": ["hlr"]
        },
        {
          "name": "libxinerama",
          "features": ["hlr"]
        },
        {
          "name": "libxxf86vm",
          "features": ["hlr"]
        }
      ]
    },
    "tests": {
      "description": "Build and install the upstream SDL tests"
    },
    "x11": {
      "description": "Build the X11 video backend for native graphical applications",
      "dependencies": [
        "libxcursor",
        "libxext",
        "libxfixes",
        "libxi",
        "libxinerama",
        "libxrandr",
        "libxrender",
        "libxscrnsaver",
        "libxxf86vm"
      ]
    }
  }
}
