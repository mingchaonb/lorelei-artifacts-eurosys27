+static void X11_GL_LogLoreleiPresentationTimestamp(void)
+{
+    static int initialized = 0;
+    static FILE *stream = NULL;
+    struct timespec now;
+    const char *path;
+
+    if (!initialized) {
+        initialized = 1;
+        path = getenv("LORELEI_FPS_LOG");
+        if (path != NULL && *path != '\0') {
+            stream = fopen(path, "a");
+        }
+    }
+    if (stream == NULL) {
+        return;
+    }
+    if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
+        fprintf(stream, "%lld.%09ld\n", (long long)now.tv_sec, now.tv_nsec);
+        fflush(stream);
+    }
+}
+
