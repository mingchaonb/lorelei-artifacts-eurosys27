{
  "name": "glvnd",
  "version": "1.7.0-system",
  "port-version": 6,
  "description": "Lorelei thunk and validation binaries for the Ubuntu system libglvnd DSO",
  "homepage": "https://gitlab.freedesktop.org/glvnd/libglvnd",
  "license": "MIT",
  "supports": "linux & !x64 & !x86",
  "dependencies": [
    {
      "name": "libx11",
      "features": [
        "hlr"
      ]
    },
    "opengl-registry",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
