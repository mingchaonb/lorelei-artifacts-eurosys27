diff --git a/include/lorelei-breakdown.h b/include/lorelei-breakdown.h
new file mode 100644
index 0000000000..f3332bc82b
--- /dev/null
+++ b/include/lorelei-breakdown.h
@@ -0,0 +1,166 @@
+/*
+ * Lorelei pass-through call breakdown instrumentation.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_LORELEI_BREAKDOWN_H
+#define QEMU_LORELEI_BREAKDOWN_H
+
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+
+enum LoreleiBreakdownPhase {
+    LORELEI_BREAKDOWN_IDLE,
+    LORELEI_BREAKDOWN_GTL_PACKING,
+    LORELEI_BREAKDOWN_HECMID_TRIGGER,
+    LORELEI_BREAKDOWN_QEMU_DISPATCH,
+    LORELEI_BREAKDOWN_HTL_UNPACKING,
+};
+
+enum {
+    LORELEI_BREAKDOWN_MARKER_START = 1,
+    LORELEI_BREAKDOWN_MARKER_END = 2,
+    LORELEI_BREAKDOWN_MARKER_TAG = 0xa001,
+};
+
+struct LoreleiBreakdownData {
+    enum LoreleiBreakdownPhase phase;
+    uint64_t last_tick;
+    uint64_t gtl_ticks;
+    uint64_t hecmid_ticks;
+    uint64_t qemu_ticks;
+    uint64_t htl_ticks;
+    uint64_t samples;
+    uint64_t invalid_sequences;
+    bool reported;
+};
+
+extern __thread struct LoreleiBreakdownData lorelei_breakdown_data;
+
+static inline uint64_t lorelei_breakdown_read_counter(void)
+{
+#if defined(__x86_64__)
+    uint32_t lo, hi;
+
+    __asm__ volatile("rdtsc" : "=a"(lo), "=d"(hi) : : "memory");
+    return ((uint64_t)hi << 32) | lo;
+#elif defined(__aarch64__)
+    uint64_t value;
+
+    __asm__ volatile("mrs %0, cntvct_el0" : "=r"(value) : : "memory");
+    return value;
+#elif defined(__riscv)
+    uint64_t value;
+
+    __asm__ volatile("rdcycle %0" : "=r"(value) : : "memory");
+    return value;
+#else
+#error Unsupported host architecture for Lorelei breakdown instrumentation
+#endif
+}
+
+static inline uint64_t lorelei_breakdown_counter_frequency(void)
+{
+#if defined(__aarch64__)
+    uint64_t value;
+
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(value));
+    return value;
+#else
+    return 0;
+#endif
+}
+
+static inline void lorelei_breakdown_start(void)
+{
+    struct LoreleiBreakdownData *data = &lorelei_breakdown_data;
+
+    if (data->phase != LORELEI_BREAKDOWN_IDLE) {
+        data->invalid_sequences++;
+    }
+    data->last_tick = lorelei_breakdown_read_counter();
+    data->phase = LORELEI_BREAKDOWN_GTL_PACKING;
+}
+
+static inline bool lorelei_breakdown_accumulate(
+    enum LoreleiBreakdownPhase expected,
+    enum LoreleiBreakdownPhase next,
+    uint64_t *total)
+{
+    struct LoreleiBreakdownData *data = &lorelei_breakdown_data;
+    uint64_t tick;
+
+    if (data->phase != expected) {
+        data->invalid_sequences++;
+        return false;
+    }
+    tick = lorelei_breakdown_read_counter();
+    *total += tick - data->last_tick;
+    data->last_tick = tick;
+    data->phase = next;
+    return true;
+}
+
+static inline void lorelei_breakdown_gtl_end(void)
+{
+    lorelei_breakdown_accumulate(LORELEI_BREAKDOWN_GTL_PACKING,
+                                 LORELEI_BREAKDOWN_HECMID_TRIGGER,
+                                 &lorelei_breakdown_data.gtl_ticks);
+}
+
+static inline void lorelei_breakdown_syscall(void)
+{
+    lorelei_breakdown_accumulate(LORELEI_BREAKDOWN_HECMID_TRIGGER,
+                                 LORELEI_BREAKDOWN_QEMU_DISPATCH,
+                                 &lorelei_breakdown_data.hecmid_ticks);
+}
+
+static inline void lorelei_breakdown_dispatch(void)
+{
+    lorelei_breakdown_accumulate(LORELEI_BREAKDOWN_QEMU_DISPATCH,
+                                 LORELEI_BREAKDOWN_HTL_UNPACKING,
+                                 &lorelei_breakdown_data.qemu_ticks);
+}
+
+static inline void lorelei_breakdown_host_end(void)
+{
+    if (lorelei_breakdown_accumulate(LORELEI_BREAKDOWN_HTL_UNPACKING,
+                                     LORELEI_BREAKDOWN_IDLE,
+                                     &lorelei_breakdown_data.htl_ticks)) {
+        lorelei_breakdown_data.samples++;
+    }
+}
+
+static inline void lorelei_breakdown_report(void)
+{
+    struct LoreleiBreakdownData *data = &lorelei_breakdown_data;
+    uint64_t frequency = lorelei_breakdown_counter_frequency();
+
+    if (data->reported || data->samples == 0) {
+        return;
+    }
+    data->reported = true;
+    fprintf(stderr,
+            "LORELEI_BREAKDOWN counter_hz=%" PRIu64
+            " samples=%" PRIu64 " invalid=%" PRIu64 "\n",
+            frequency, data->samples, data->invalid_sequences);
+    fprintf(stderr,
+            "LORELEI_BREAKDOWN_TICKS gtl=%" PRIu64
+            " hecmid=%" PRIu64 " qemu=%" PRIu64 " htl=%" PRIu64 "\n",
+            data->gtl_ticks, data->hecmid_ticks, data->qemu_ticks,
+            data->htl_ticks);
+    if (frequency != 0) {
+        double scale = 1000000000.0 / (double)frequency / data->samples;
+
+        fprintf(stderr,
+                "LORELEI_BREAKDOWN_NS_PER_CALL gtl=%.6f hecmid=%.6f"
+                " qemu=%.6f htl=%.6f total=%.6f\n",
+                data->gtl_ticks * scale, data->hecmid_ticks * scale,
+                data->qemu_ticks * scale, data->htl_ticks * scale,
+                (data->gtl_ticks + data->hecmid_ticks + data->qemu_ticks +
+                 data->htl_ticks) * scale);
+    }
+}
+
+#endif
