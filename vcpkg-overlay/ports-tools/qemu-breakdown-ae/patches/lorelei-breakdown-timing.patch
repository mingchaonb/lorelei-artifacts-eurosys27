@@ -61,6 +62,27 @@ void helper_cpuid(CPUX86State *env)
     env->regs[R_EDX] = edx;
 }

+void helper_lorelei_breakdown_marker(CPUX86State *env)
+{
+    uint32_t operation = env->regs[R_EAX];
+    uint32_t tag = env->regs[R_EBX];
+
+    if (tag != LORELEI_BREAKDOWN_MARKER_TAG) {
+        raise_exception_err_ra(env, EXCP06_ILLOP, 0, GETPC());
+    }
+
+    switch (operation) {
+    case LORELEI_BREAKDOWN_MARKER_START:
+        lorelei_breakdown_start();
+        return;
+    case LORELEI_BREAKDOWN_MARKER_END:
+        lorelei_breakdown_gtl_end();
+        return;
+    default:
+        raise_exception_err_ra(env, EXCP06_ILLOP, 0, GETPC());
+    }
+}
+
 void helper_rdtsc(CPUX86State *env)
 {
     uint64_t val;
