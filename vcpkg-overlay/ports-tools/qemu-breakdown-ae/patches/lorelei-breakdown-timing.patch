     bool handled;

     qemu_syscall_number = LORELEI_SYSCALL_NUMBER;
+    if (request == LORELEI_INVOKE_PROC &&
+        lorelei_breakdown_data.phase == LORELEI_BREAKDOWN_QEMU_DISPATCH) {
+        lorelei_breakdown_dispatch();
+    }
     handled = lorelei_handle_call_inner(request, a2, a3, a4);
+    if (request == LORELEI_INVOKE_PROC &&
+        lorelei_breakdown_data.phase == LORELEI_BREAKDOWN_HTL_UNPACKING) {
+        lorelei_breakdown_host_end();
+    }
     qemu_syscall_number = saved_syscall_number;
     return handled;
 }
